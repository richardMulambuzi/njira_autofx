[Unit]
Description=Stream live broker ticks into the njira tick store
StartLimitIntervalSec=300
StartLimitBurst=5
After=njira-api.service
Requires=njira-api.service

[Service]
Type=simple
ExecStart=/usr/bin/podman exec njira-api python -u manage.py ticks_engine
Restart=on-failure
RestartSec=15
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
