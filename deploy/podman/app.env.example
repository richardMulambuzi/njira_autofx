# =============================================================================
# NJIRA FX API - ENVIRONMENT VARIABLES (PRODUCTION)
# =============================================================================
# Copy this file to /opt/apps/njira-api/app.env on the host, fill in ALL
# placeholder values, and set mode 600. NEVER commit real secrets to git.
#
# The quadlet loads this via: EnvironmentFile=/opt/apps/njira-api/app.env

# -----------------------------------------------------------------------------
# DJANGO APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
ENV_MODE=prod
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS="indemw.tech,127.0.0.1,localhost"
CORS_ALLOWED_ORIGINS="https://indemw.tech,http://indemw.tech:8100"

# -----------------------------------------------------------------------------
# PRIVATE KEY FOR JWT / SECURITY (PEM format, single line with \n escapes)
# -----------------------------------------------------------------------------
PRIVATE_KEY_CONTENT=

# -----------------------------------------------------------------------------
# PEPPERSTONE / CTRADER (Broker API)
# -----------------------------------------------------------------------------
PEPPERSTONE_CLIENT_ID=
PEPPERSTONE_CLIENT_SECRET=
PEPPERSTONE_ACCESS_TOKEN=
PEPPERSTONE_REFRESH_TOKEN=
PEPPERSTONE_ACCOUNT_ID=
PEPPERSTONE_ENVIRONMENT=demo

# -----------------------------------------------------------------------------
# TRADING PROVIDER ABSTRACTION
# -----------------------------------------------------------------------------
TRADING_PROVIDER=pepperstone
TRADING_MODE=demo
TRADING_SYMBOLS="EURUSD,GBPUSD,XAUUSD,USDJPY,NAS100,US500,US30,WTOIL-PERP"
TRADING_ASSETS='[{"symbol":"EURUSD","spread":"0.0 - 0.2 pips","spread_label":"Lowest","volatility":"Steady / Medium","best_time":"London & New York Session"},{"symbol":"USDJPY","spread":"0.1 - 0.3 pips","spread_label":"Very Low","volatility":"Fast / Trendy","best_time":"Tokyo & New York Session"},{"symbol":"GBPUSD","spread":"0.3 - 0.5 pips","spread_label":"Low","volatility":"High / Aggressive","best_time":"London Session"},{"symbol":"XAUUSD","spread":"1.0 - 2.0 pips","spread_label":"Medium","volatility":"Extremely High","best_time":"New York Session"},{"symbol":"NAS100","name":"NASDAQ 100","description":"High volatility - moves much faster and further each day than the S&P 500 or Dow Jones. Tech driven - heavily influenced by a few massive tech stocks.","volatility":"High","best_time":"US Session (New York)"},{"symbol":"US500","name":"S&P 500","description":"Diversification - tracks 500 companies across all sectors, much less erratic than NASDAQ. Technical analysis - widely considered the most obedient index for chart patterns, support and resistance.","volatility":"Moderate","best_time":"US Session (New York)"},{"symbol":"US30","name":"Dow Jones 30","description":"Price-weighted - tracks 30 massive companies; a single stock with a high share price can heavily shift the whole index.","volatility":"Moderate-High","best_time":"US Session (New York)"},{"symbol":"WTOIL-PERP","name":"Crude Oil WTI","underlying":"West Texas Intermediate (WTI)","spread":"~2.0 points","spread_label":"Minimum","max_leverage":"Up to 1:50","commission":"$0","best_time":"London & New York Session"}]'

# -----------------------------------------------------------------------------
# CLICKHOUSE DATABASE (dedicated 'forex' user)
# -----------------------------------------------------------------------------
CLICKHOUSE_HOST=indemw.tech
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=forex
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=njra_markets
CLICKHOUSE_SECURE=false

CLICKHOUSE_TICKS_TABLE=njra_markets.forex_ticks
CLICKHOUSE_TRADE_HISTORY_TABLE=njra_markets.trade_history
CLICKHOUSE_CANDLES_TABLE=njra_markets.candles
CLICKHOUSE_SIGNALS_V2_TABLE=njra_markets.trading_signals_v2
CLICKHOUSE_FVG_TABLE=njra_markets.fair_value_gaps

# -----------------------------------------------------------------------------
# AUTHZ / SECURITY GATE 1 REMEDIATION
# -----------------------------------------------------------------------------
TICKS_INGEST_API_KEY=
TRADE_MAX_VOLUME=100000
TRADE_DAILY_LIMIT=20
TRADE_DAILY_VOLUME_LIMIT=100000

# -----------------------------------------------------------------------------
# RISK MANAGER
# -----------------------------------------------------------------------------
RISK_STARTING_BALANCE=50000.0
RISK_MAX_DAILY_LOSS_PCT=0.02
RISK_MAX_SPREAD_PIPS=0.3
RISK_ACCOUNT_ID=48327442

# -----------------------------------------------------------------------------
# TICKS ENGINE / MTF AGGREGATOR TUNING
# -----------------------------------------------------------------------------
TICKS_BATCH_SIZE=100
TICKS_FLUSH_SECONDS=1
TICKS_LOG_LEVEL=INFO
MTF_REFRESH_SECONDS=5

# -----------------------------------------------------------------------------
# STRATEGY & TRADING CONSTANTS
# -----------------------------------------------------------------------------
BUFFER_PIPS=0.00050
TOLERANCE=0.00040
RISK_PERCENTAGE=0.02
REWARD_TO_RISK_RATIO=2.0
MAX_RETRIES=3
CLUSTER_PIP_RANGE=0.0020
MIN_TP_PIPS=40
MAX_ALLOWED_PIP_DIFF=0.1
VOLATILITY_BOOST=0.5
MAX_RISK_REWARD_RATIO=4.0
MIN_RISK_REWARD_RATIO=1.5
MARGIN_THRESHOLD=0.0005
TOLERANCE_PIPS=0.0020
PIP_VALUE=0.0001
TIMEFRAMES='{"Day":86400,"4H":14400,"1H":3600,"30M":1800,"15M":900,"5M":300,"1M":60}'

# -----------------------------------------------------------------------------
# QUEUE & BROADCAST CONFIGURATION
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# Pusher real-time events
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap2
PUSHER_HOST=api-ap2.pusher.com
PUSHER_PORT=443
PUSHER_SCHEME=https

# -----------------------------------------------------------------------------
# MAIL SETTINGS (CPANEL / RESEND PRODUCTION) - FILL IN ALL PLACEHOLDERS
# -----------------------------------------------------------------------------
MAIL_MAILER=resend
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_TIMEOUT=60
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Njira FX

RESEND_API_KEY=

# -----------------------------------------------------------------------------
# GEMINI / LLM (trading_optimizer) - ROTATE KEY BEFORE PRODUCTION USE
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# PRODUCTION URLS
# -----------------------------------------------------------------------------
PROD_DB_URL=http://indemw.tech:8123
PROD_FRONTEND_URL=https://indemw.tech
PROD_API_URL=https://indemw.tech:8004

# -----------------------------------------------------------------------------
# DJANGO LOG LEVEL
# -----------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO