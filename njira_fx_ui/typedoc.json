{
  "entryPoints": ["src"], // or "app" or "lib", depending on your folder structure
  "out": "docs",
  "tsconfig": "tsconfig.json",
  "includeVersion": true,
  "excludePrivate": true,
  "excludeProtected": false,
  "excludeInternal": true,
  "excludeExternals": true,
  "skipErrorChecking": true,
  "hideGenerator": true,
  "plugin": ["typedoc-plugin-markdown"], // Optional if you want Markdown output
  "readme": "README.md", // or "none"
  "gitRevision": "main",
  "sort": ["source-order"]
}
